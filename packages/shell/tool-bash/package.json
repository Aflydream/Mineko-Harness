{
  "name": "@aflydream/mnh-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aflydream/mineko-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@aflydream/mnh-agent": "workspace:^",
    "@aflydream/mnh-shell": "workspace:^",
    "@aflydream/mnh-shell-env": "workspace:^",
    "@aflydream/mnh-invariants": "workspace:^",
    "@aflydream/mnh-llm": "workspace:^",
    "@aflydream/mnh-sandbox": "workspace:^",
    "@aflydream/mnh-sandbox-policy": "workspace:^",
    "@aflydream/mnh-system-prompt": "workspace:^",
    "@aflydream/mnh-jobs": "workspace:^",
    "@aflydream/mnh-tools": "workspace:^",
    "@aflydream/mnh-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@aflydream/mnh-agent": "workspace:^",
    "@aflydream/mnh-agent-loop": "workspace:^",
    "@aflydream/mnh-agent-loop-testkit": "workspace:^",
    "@aflydream/mnh-shell": "workspace:^",
    "@aflydream/mnh-shell-env": "workspace:^",
    "@aflydream/mnh-bash-local": "workspace:^",
    "@aflydream/mnh-invariants": "workspace:^",
    "@aflydream/mnh-llm": "workspace:^",
    "@aflydream/mnh-subprocess-local": "workspace:^",
    "@aflydream/mnh-sandbox": "workspace:^",
    "@aflydream/mnh-sandbox-policy": "workspace:^",
    "@aflydream/mnh-session": "workspace:^",
    "@aflydream/mnh-session-persistence-jsonl": "workspace:^",
    "@aflydream/mnh-system-prompt": "workspace:^",
    "@aflydream/mnh-jobs": "workspace:^",
    "@aflydream/mnh-jobs-local": "workspace:^",
    "@aflydream/mnh-tool-jobs": "workspace:^",
    "@aflydream/mnh-tools": "workspace:^",
    "@aflydream/mnh-user-approval": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
